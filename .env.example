# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID from the app's General Information page
CLIENT_ID=

# Optional: a server ID to register commands to instantly while developing.
# Leave empty to register commands globally (can take up to an hour to appear).
DEV_GUILD_ID=

# Optional: comma-separated user IDs allowed to run owner-only commands
OWNER_IDS=

# Optional: embed accent color as a hex value
EMBED_COLOR=#5865F2
